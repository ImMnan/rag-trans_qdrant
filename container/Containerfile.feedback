# ==========================================
# BUILD STAGE: Compile Go binary
# Build context: repo root (docker build -f container/Containerfile.feedback .)
# ==========================================
FROM golang:1.27.3 AS builder

WORKDIR /build

ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH

# Cache dependencies before copying source — layer is reused unless go.mod/go.sum change
COPY feedback/go.mod feedback/go.sum ./
RUN go mod download

COPY feedback/ ./

# Build a fully static binary — no libc dependency, safe for distroless
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -mod=readonly -trimpath \
    -ldflags="-s -w -X main.orcaVersion=${VERSION}" -o /feedback-server .

# ==========================================
# RUNTIME: Non-root distroless image
# ==========================================
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /feedback-server /feedback-server

ENV FIBER_PORT=8080
EXPOSE 8080

USER nonroot:nonroot

ENTRYPOINT ["/feedback-server"]
