# PyTorch's CUDA runtime image supplies a CUDA-enabled torch build. A plain
# python:3.11-slim image installs a CPU-only torch build through pip.
FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

# Set execution flags for stability and unbuffered real-time logs
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME="/models" \
    MODEL_DIR="/models" \
    TRANSFORMERS_CACHE="/tmp/transformers" \
    HF_MODULES_CACHE="/tmp/hf_modules" \
    TRANSFORMERS_OFFLINE=1 \
    HF_DATASETS_OFFLINE=1 \
    EMBED_MODEL="Alibaba-NLP/gte-Qwen2-1.5B-instruct" \
    EMBED_DEVICE="auto" \
    EMBED_QUERY_TEMPLATE="{text}" \
    EMBED_DOCUMENT_TEMPLATE="{text}"

WORKDIR /app

# Install application dependencies without replacing the CUDA-enabled torch
# already provided by the base image.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the GTE entrypoint and normalize the filename so uvicorn can import it as a module
COPY gte-main.py ./main.py

# Model files are mounted at /models; runtime metadata and dynamic modules are writable.
RUN mkdir -p /models /tmp/transformers /tmp/hf_modules

# Expose internal FastAPI gateway port
EXPOSE 8000

# Execute the web API using Uvicorn worker threads
# Single worker: SentenceTransformer loads the model once via lifespan().
# Scale horizontally via Deployment replicas, not uvicorn workers.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
